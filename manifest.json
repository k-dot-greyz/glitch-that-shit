{
  "manifest_version": 3,
  "name": "zenOS: glitch-that-shit",
  "version": "0.3.0",
  "version_name": "0.3.0-rc.1",
  "description": "Glitch out unwanted words, phrases and ads with custom visual effects. Privacy-first, local-only, zenOS a11y engine.",
  "permissions": ["storage", "contextMenus", "activeTab"],
  "background": {
    "service_worker": "background.js"
  },
  "action": {
    "default_popup": "popup.html",
    "default_title": "glitch-that-shit",
    "default_icon": {
      "16": "icons/icon16.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "options_ui": {
    "page": "options.html",
    "open_in_tab": true
  },
  "content_scripts": [
    {
      "matches": ["http://*/*", "https://*/*"],
      "js": ["content.js"],
      "run_at": "document_start"
    }
  ],
  "commands": {
    "_execute_action": {
      "suggested_key": { "default": "Ctrl+Shift+F" },
      "description": "Quick filter (open popup)"
    },
    "toggle-extension": {
      "suggested_key": { "default": "Ctrl+Shift+G" },
      "description": "Toggle glitching on/off"
    },
    "cycle-effects": {
      "suggested_key": { "default": "Ctrl+Shift+E" },
      "description": "Cycle visual effect"
    },
    "open-settings": {
      "suggested_key": { "default": "Ctrl+Shift+S" },
      "description": "Open settings"
    }
  },
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  }
}
