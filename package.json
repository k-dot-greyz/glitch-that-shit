{
  "name": "glitch-that-shit",
  "version": "0.3.0-rc.1",
  "description": "Glitch out unwanted words, phrases and ads with custom visual effects. Privacy-first MV3 browser extension with the zenOS OKLCH a11y engine.",
  "type": "module",
  "scripts": {
    "build": "node scripts/build.mjs",
    "build:chrome": "node scripts/build.mjs --target chrome",
    "build:firefox": "node scripts/build.mjs --target firefox",
    "package": "npm run verify && node scripts/build.mjs",
    "lint": "tsc --noEmit",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "validate:manifest": "node scripts/validate-manifest.mjs dist/chrome chrome && node scripts/validate-manifest.mjs dist/firefox firefox",
    "verify": "npm run lint && npm test",
    "smoke": "node scripts/smoke.mjs",
    "e2e": "node scripts/e2e.mjs"
  },
  "devDependencies": {
    "@types/chrome": "0.3.4",
    "@vitest/coverage-v8": "4.1.11",
    "esbuild": "0.28.2",
    "jsdom": "28.1.0",
    "typescript": "5.9.3",
    "vite": "8.3.3",
    "vitest": "4.1.11"
  },
  "private": true,
  "license": "MIT",
  "engines": {
    "node": "^20.19.0 || >=22.12.0"
  }
}
